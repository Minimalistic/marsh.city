{
  "name": "marsh.city",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node plugins/generate-art-thumbs.mjs && astro dev",
    "build": "node plugins/generate-lqip.mjs && node plugins/generate-art-thumbs.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "resume:pdf": "node scripts/resume-pdf.mjs",
    "test": "npm run build && npm run test:smoke",
    "test:smoke": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.4",
    "sharp": "0.35.5"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": "^8.5.28",
    "devalue": "^5.9.4",
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "openai": "7.42.0",
    "playwright": "1.64.1"
  }
}
