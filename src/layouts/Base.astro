---
import '../styles/global.css';
import { getCollection } from 'astro:content';
// inlined, not bundled: it hides headings, so it has to run before first paint or they blink out and back
import fadeInScript from '../scripts/fade-in.js?raw';
interface Props {
  title?: string;
  description?: string;
  image?: string;      // root-relative path to a social-card image (1.91:1 reads best)
  imageAlt?: string;
}
const {
  title = 'marsh.city',
  description = "Jason Marsh — Director of Technology, assistive technology, AI-integrated tools",
  image = '/og-default.jpg',  // sitewide default card (scripts/og-card.mjs) when a page doesn't supply its own
  imageAlt = 'marsh.city - Jason Marsh, Director of Technology, framed by painted foliage',
} = Astro.props;
const fullTitle = title === 'marsh.city' ? title : `${title} — marsh.city`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;  // social cards require an absolute URL
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href) ? 'page' as const : undefined;

// command palette index — built at render time, shipped as JSON to the client
const projects = await getCollection('projects');
const posts = await getCollection('posts', ({ data }) => !data.draft);
const playgroundItems = await getCollection('playground');
const artSeries = await getCollection('art');
const paletteItems = [
  { type: 'page',    title: 'Home',     url: '/',          hint: 'landing' },
  { type: 'page',    title: 'Projects', url: '/projects/', hint: 'all projects' },
  { type: 'page',    title: 'Posts',    url: '/posts/',    hint: 'writing' },
  { type: 'page',    title: 'Art',      url: '/art/',      hint: 'AI-generated image series' },
  { type: 'page',    title: 'Playground', url: '/playground/', hint: 'experiments' },
  { type: 'page',    title: 'About',    url: '/about/',    hint: 'who I am' },
  { type: 'page',    title: 'Resume',   url: '/resume/',   hint: 'work history' },
  { type: 'page',    title: 'Colophon', url: '/oak/',      hint: 'how this site is built' },
  { type: 'page',    title: 'Now',      url: '/now/',      hint: 'current focus' },
  ...projects.map((p) => ({
    type: 'project',
    title: p.data.title,
    url: `/projects/${p.id}/`,
    hint: p.data.description,
  })),
  ...posts.map((p) => ({
    type: 'post',
    title: p.data.title,
    url: `/posts/${p.id}/`,
    hint: p.data.description ?? '',
  })),
  ...playgroundItems.map((p) => ({
    type: 'playground',
    title: p.data.title,
    url: `/playground/${p.id}/`,
    hint: p.data.description,
  })),
  ...artSeries.map((s) => ({
    type: 'art',
    title: s.data.title,
    url: `/art/${s.id}/`,
    hint: s.data.description,
  })),
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="marsh.city" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="marsh.city — posts" href="/rss.xml" />
    <!-- body text and headings are above the fold on every page; mono waits for the CSS -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // set data-theme before CSS paints to avoid a flash.
      // stored pref wins; 'auto' (default) follows system.
      (() => {
        let stored;
        try { stored = localStorage.getItem('theme'); } catch {}
        const pref = (stored === 'light' || stored === 'dark') ? stored : 'auto';
        const resolved = pref === 'auto'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : pref;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themePref = pref;
      })();
    </script>
  </head>
  <body>
    <div class="stage-frame" aria-hidden="true"></div>
<div class="layout">
      <a href="#main" class="skip-link">Skip to main content</a>
      <nav class="site-nav">
        <a href="/" class="brand">marsh.city</a>
        <div class="links">
          <a href="/projects/" class="nav-hide-mobile" aria-current={isActive('/projects/')}>projects</a>
          <a href="/posts/" class="nav-hide-mobile" aria-current={isActive('/posts/')}>posts</a>
          <a href="/playground/" class="nav-hide-mobile" aria-current={isActive('/playground/')}>playground</a>
          <a href="/resume/" class="nav-hide-mobile" aria-current={isActive('/resume/')}>resume</a>
          <a href="/about/" class="nav-hide-mobile" aria-current={isActive('/about/')}>about</a>
          <button type="button" class="cmdk-trigger nav-search" aria-label="Open command palette" aria-keyshortcuts="Meta+K Control+K" title="Search (⌘K)">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <line x1="20" y1="20" x2="16.5" y2="16.5"/>
            </svg>
          </button>
          <div class="nav-menu">
            <button type="button" class="nav-menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu-panel">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="4" y1="7" x2="20" y2="7"/>
                <line x1="4" y1="12" x2="20" y2="12"/>
                <line x1="4" y1="17" x2="20" y2="17"/>
              </svg>
            </button>
            <div class="nav-menu-panel" id="nav-menu-panel" hidden>
              <a href="/projects/" class="nav-menu-link nav-show-mobile" aria-current={isActive('/projects/')}>
                <span class="nav-menu-item-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">Projects</span>
              </a>
              <a href="/posts/" class="nav-menu-link nav-show-mobile" aria-current={isActive('/posts/')}>
                <span class="nav-menu-item-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 20h9"/>
                    <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">Posts</span>
              </a>
              <a href="/playground/" class="nav-menu-link nav-show-mobile" aria-current={isActive('/playground/')}>
                <span class="nav-menu-item-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5"/>
                    <line x1="12" y1="22" x2="12" y2="15.5"/>
                    <polyline points="22 8.5 12 15.5 2 8.5"/>
                    <polyline points="2 15.5 12 8.5 22 15.5"/>
                    <line x1="12" y1="2" x2="12" y2="8.5"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">Playground</span>
              </a>
              <a href="/resume/" class="nav-menu-link nav-show-mobile" aria-current={isActive('/resume/')}>
                <span class="nav-menu-item-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                    <polyline points="14 3 14 9 20 9"/>
                    <line x1="8" y1="13" x2="16" y2="13"/>
                    <line x1="8" y1="17" x2="13" y2="17"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">Resume</span>
              </a>
              <a href="/about/" class="nav-menu-link nav-show-mobile" aria-current={isActive('/about/')}>
                <span class="nav-menu-item-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M20 21a8 8 0 0 0-16 0"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">About</span>
              </a>
              <button type="button" class="theme-toggle">
                <span class="nav-menu-item-icon">
                  <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4.2"/>
                    <path d="M12 2.5v2M12 19.5v2M21.5 12h-2M4.5 12h-2M18.5 5.5l-1.4 1.4M6.9 17.1l-1.4 1.4M18.5 18.5l-1.4-1.4M6.9 6.9L5.5 5.5"/>
                  </svg>
                  <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
                  </svg>
                  <svg class="icon-auto" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="13" rx="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">Theme: <span class="theme-label">auto</span></span>
              </button>
              <button type="button" class="sound-toggle" aria-pressed="false">
                <span class="nav-menu-item-icon">
                  <svg class="icon-sound-off" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 5L6 9H3v6h3l5 4z"/>
                    <line x1="22" y1="9" x2="16" y2="15"/>
                    <line x1="16" y1="9" x2="22" y2="15"/>
                  </svg>
                  <svg class="icon-sound-on" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M11 5L6 9H3v6h3l5 4z"/>
                    <path d="M15.5 8.5a5 5 0 0 1 0 7"/>
                    <path d="M18.8 5.2a9.5 9.5 0 0 1 0 13.6"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">Sound: <span class="sound-label">off</span></span>
              </button>
              <button type="button" class="cmdk-trigger" aria-keyshortcuts="Meta+K Control+K">
                <span class="nav-menu-item-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"/>
                    <line x1="20" y1="20" x2="16.5" y2="16.5"/>
                  </svg>
                </span>
                <span class="nav-menu-item-label">Search</span>
                <span class="nav-menu-item-hint"><kbd>⌘</kbd><kbd>K</kbd></span>
              </button>
            </div>
          </div>
        </div>
      </nav>

      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <div class="cmdk" id="cmdk" role="dialog" aria-modal="true" aria-labelledby="cmdk-input-label" hidden>
      <div class="cmdk-backdrop" data-cmdk-close></div>
      <div class="cmdk-panel">
        <label id="cmdk-input-label" class="sr-only" for="cmdk-input">Search projects, posts, and pages</label>
        <input id="cmdk-input" class="cmdk-input" type="text" role="combobox" aria-expanded="true" placeholder="Search projects, posts, pages…" autocomplete="off" spellcheck="false" aria-autocomplete="list" aria-controls="cmdk-results" />
        <ul id="cmdk-results" class="cmdk-results" role="listbox"></ul>
        <div class="cmdk-hint" aria-hidden="true">
          <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
          <span><kbd>↵</kbd> open</span>
          <span><kbd>esc</kbd> close</span>
        </div>
      </div>
    </div>

    <footer class="site-foot">
      <div class="site-foot-foliage" aria-hidden="true">
        <div class="foliage-frame foliage-frame--forest"><div class="foliage-layer"></div></div>
        <div class="foliage-frame foliage-frame--back"><div class="foliage-layer"></div></div>
        <div class="foliage-frame foliage-frame--mid"><div class="foliage-layer"></div></div>
        <div class="foliage-frame foliage-frame--front"><div class="foliage-layer"></div></div>
        <div class="foliage-frame foliage-frame--ground"><div class="foliage-layer"></div></div>
      </div>
      <div class="site-foot-inner">
        <span>© <a href="/about/">Jason Marsh</a></span>
        <div class="foot-links">
          <a href="mailto:jason@marsh.city">email</a>
          <a href="https://github.com/Minimalistic">github</a>
          <a href="https://www.linkedin.com/in/jason-marsh">linkedin</a>
          <a href="https://github.com/Minimalistic/marsh.city">source</a>
        </div>
      </div>
    </footer>

    <script is:inline set:html={fadeInScript} />
    <!-- index data stays per-page; `<` is escaped so a title can't close the tag -->
    <script type="application/json" id="cmdk-items" set:html={JSON.stringify(paletteItems).replace(/</g, '\\u003c')} />
    <script>
      // processed (not is:inline) so Astro bundles these into one hashed file
      // the browser caches across pages; order matters — theme-toggle defines
      // window.__isDark / __themeMix before starfield and fireflies read them
      import '../scripts/lqip.js';
      import '../scripts/nav-menu.js';
      import '../scripts/theme-toggle.js';
      import '../scripts/ambient-toggle.js';
      import '../scripts/starfield.js';
      import '../scripts/fireflies.js';
      import '../scripts/foliage.js';
      import '../scripts/code-copy.js';
      import '../scripts/command-palette.js';
      import '../scripts/mermaid.js';
      import '../scripts/lightbox.js';
    </script>

    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "d6eace1f27904e13b9d20419621d042b"}'></script>
  </body>
</html>
