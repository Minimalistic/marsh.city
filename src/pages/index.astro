---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const projects = (await getCollection('projects'))
  .sort((a, b) => (b.data.updated ?? new Date(0)).valueOf() - (a.data.updated ?? new Date(0)).valueOf())
  .slice(0, 6);
// art series surfaced on the home page as a visual strip — newest first,
// only series that actually have images
const artSeries = (await getCollection('art'))
  .sort((a, b) => (b.data.updated ?? new Date(0)).valueOf() - (a.data.updated ?? new Date(0)).valueOf())
  .filter((s) => s.data.images.length > 0);
// flat pool of every art image across all series — the strip tiles cycle
// through this shuffled, so the strip isn't bound to one mission per tile
const artPool = artSeries
  .flatMap((s) => s.data.images.map((im) => ({ src: im.src, url: `/art/${s.id}/`, title: s.data.title })))
  .slice(0, 30);
const STRIP_TILES = Math.min(4, artPool.length);
// seed each tile's first paint from a different series (round-robin) so the
// strip looks varied on load, before the client shuffle takes over
const stripInitial = Array.from({ length: STRIP_TILES }, (_, i) => {
  const s = artSeries[i % artSeries.length];
  const img = s.data.images[Math.floor(i / artSeries.length) % s.data.images.length];
  return { src: img.src, url: `/art/${s.id}/`, title: s.data.title };
});
---
<Base description="Jason Marsh — Director of Technology, assistive technology, AI engineering.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jason Marsh",
    "url": "https://marsh.city",
    "jobTitle": "Director of Technology",
    "worksFor": { "@type": "Organization", "name": "Lighthouse Center for Vital Living" },
    "knowsAbout": ["Assistive Technology", "Node.js", "Python", "AI Engineering", "LLM Integration", "Accessibility"],
    "sameAs": [
      "https://github.com/Minimalistic",
      "https://www.linkedin.com/in/jason-marsh"
    ]
  })} />
  <div class="hero">
    <h1>Jason Marsh</h1>
    <p class="subtitle">
      Director of Technology at an assistive technology & older adult services nonprofit.
      <strong>13+ years in IT</strong> - infrastructure, assistive technology,
      and <strong>AI-integrated tools</strong> I design and build end to end.
    </p>
  </div>

  {artSeries.length > 0 && (
    <>
      <div class="section-header">
        <h2>Art</h2>
        <a href="/art/">View all</a>
      </div>
      <div class="art-strip">
        {stripInitial.map((it) => {
          return (
            <a class="art-strip-card" href={it.url}>
              <div class="art-strip-cover">
                <img class="layer" alt="" loading="lazy" decoding="async" />
                <img class="layer" alt="" loading="lazy" decoding="async" />
              </div>
              <span class="art-strip-title">{it.title}</span>
            </a>
          );
        })}
      </div>
    </>
  )}

  <div class="section-header">
    <h2>Projects</h2>
    <a href="/projects/">View all</a>
  </div>
  {projects.map((p) => {
    const ago = p.data.updated ? (() => {
      const days = Math.floor((Date.now() - p.data.updated.valueOf()) / 86400000);
      if (days === 0) return 'today';
      if (days === 1) return 'yesterday';
      if (days < 30) return `${days}d ago`;
      if (days < 365) return `${Math.floor(days / 30)}mo ago`;
      return `${Math.floor(days / 365)}y ago`;
    })() : null;
    return (
      <a class="card" href={`/projects/${p.id}/`}>
        <h3>{p.data.title}<span class={`status status-${p.data.status}`} aria-label={({ idea: 'Idea', wip: 'Work in progress', shipped: 'Shipped', archived: 'Archived' })[p.data.status]}>{p.data.status}</span>{p.data.url && <span class="demo-badge">live demo</span>}</h3>
        <p class="meta">{p.data.description}</p>
        {ago && <p class="meta" style="margin-top:0.25rem;font-size:0.78rem;color:var(--fg-muted)">updated {ago}</p>}
        {p.data.tags && p.data.tags.length > 0 && (
          <div class="tags">
            {p.data.tags.map((t: string) => <span class="tag">{t}</span>)}
          </div>
        )}
      </a>
    );
  })}

  {posts.length > 0 && (
    <>
      <div class="section-header">
        <h2>Writing</h2>
        <a href="/posts/">View all</a>
      </div>
      {posts.map((p) => (
        <a class="card" href={`/posts/${p.id}/`}>
          <h3>{p.data.title}</h3>
          <p class="meta">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
        </a>
      ))}
    </>
  )}

  <style>
    .art-strip {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 1rem;
      margin: 0 0 0.5rem;
    }
    .art-strip-card { display: block; min-width: 0; }
    .art-strip-cover {
      position: relative;
      aspect-ratio: 3 / 2;
      border-radius: 6px;
      overflow: hidden;
      background: var(--bg-soft, rgba(0, 0, 0, 0.04));
    }
    .art-strip-cover .layer {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
    }
    @media (prefers-reduced-motion: no-preference) {
      .art-strip-cover .layer { transition: opacity 1s ease; }
    }
    .art-strip-cover .layer.is-front { opacity: 1; }
    .art-strip-card:hover .art-strip-cover .layer.is-front {
      filter: saturate(1.05) contrast(1.02);
    }
    .art-strip-title {
      display: block;
      font-size: 0.82rem;
      font-weight: 500;
      margin-top: 0.45rem;
      color: var(--fg-soft);
      line-height: 1.3;
    }
  </style>

  <script is:inline define:vars={{ artPool }}>
    // art strip: every tile cross-fades through a shuffled pool of ALL art
    // images across all series — not bound to one mission per tile. Each tile
    // walks its own shuffled queue (de-synced), updates its link + label to
    // match whatever it's currently showing, holds only two images in memory,
    // pauses off-screen, and is disabled under prefers-reduced-motion.
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const cards = [...document.querySelectorAll('.art-strip-card')];
      if (!cards.length || artPool.length < 2) return;

      function shuffled(arr) {
        const a = arr.slice();
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      }

      // random per-visit first image for each tile (distinct across tiles),
      // so the strip doesn't open on the same set every load
      const firstPicks = shuffled(artPool);
      cards.forEach((card, ci) => {
        const layers = card.querySelectorAll('.layer');
        const titleEl = card.querySelector('.art-strip-title');
        const first = firstPicks[ci % firstPicks.length];

        // reduced motion: still randomize the first image per visit, but apply
        // it instantly — no fade, no cycling
        if (reduce) {
          layers[0].src = first.src;
          layers[0].classList.add('is-front');
          card.setAttribute('href', first.url);
          titleEl.textContent = first.title;
          return;
        }

        const queue = shuffled(artPool);
        let qi = 0;
        let front = 0;
        let inView = false;

        new IntersectionObserver((entries) => {
          entries.forEach((e) => { inView = e.isIntersecting; });
        }, { threshold: 0.2 }).observe(card);

        // cross-fade the back layer in to the given image, then make it front
        function show(item) {
          const back = layers[front ^ 1];
          const cur = layers[front];
          function swap() {
            back.classList.add('is-front');
            cur.classList.remove('is-front');
            front ^= 1;
            card.setAttribute('href', item.url);
            titleEl.textContent = item.title;
          }
          back.onload = swap;
          back.src = item.src;
          if (back.complete && back.naturalWidth) swap();
        }

        function advance() {
          if (!inView) return;
          show(queue[qi % queue.length]);
          qi++;
        }

        // fade the random first pick in over the server-rendered image
        show(first);

        // stagger so tiles don't all flip in unison
        setTimeout(() => setInterval(advance, 6000), ci * 1500 + Math.floor(Math.random() * 1000));
      });
    })();
  </script>
</Base>
