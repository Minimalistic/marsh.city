---
import Base from '../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import showcaseList from '../data/showcase.json';
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const projects = (await getCollection('projects'))
  .sort((a, b) => (b.data.updated ?? new Date(0)).valueOf() - (a.data.updated ?? new Date(0)).valueOf())
  .slice(0, 6);
// Selected Works: six hand-picked tiles, in the order listed in
// src/data/showcase.json. getEntry() returns undefined for a mistyped id,
// so fail the build rather than silently dropping a tile. An item can
// override its title and url (the art tile opens the whole /art/ index).
const KIND = { projects: 'Project', playground: 'Playground', art: 'Art' } as const;
// tiles show at ~150-360px, so they load the AVIF thumbs that
// plugins/generate-art-thumbs.mjs writes (240w, 480w, and 960w for the
// double-size first tile) instead of the originals
const thumbSrcset = (src: string, widths = [240, 480]) => widths
  .map((w) => `/_thumbs${src.replace(/\.\w+$/, '')}-${w}.avif ${w}w`)
  .join(', ');
const showcase = await Promise.all(showcaseList.map(async (item, i) => {
  const entry = await getEntry(item.collection as keyof typeof KIND, item.id);
  if (!entry) throw new Error(`showcase.json: no ${item.collection} entry "${item.id}"`);
  return {
    title: item.title ?? entry.data.title,
    kind: KIND[item.collection as keyof typeof KIND],
    url: item.url ?? `/${item.collection}/${item.id}/`,
    // the first tile is the featured one: twice the size, so a bigger thumb
    srcset: i === 0 ? thumbSrcset(item.image, [480, 960]) : thumbSrcset(item.image),
    sizes: i === 0 ? '(max-width: 600px) 92vw, 330px' : '(max-width: 600px) 45vw, 160px',
    focus: item.focus ?? 'center',
  };
}));
---
<Base description="Jason Marsh — Director of Technology, assistive technology, AI-integrated tools.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jason Marsh",
    "url": "https://marsh.city",
    "jobTitle": "Director of Technology",
    "worksFor": { "@type": "Organization", "name": "Lighthouse Center for Vital Living" },
    "knowsAbout": ["Assistive Technology", "Node.js", "Python", "AI Engineering", "LLM Integration", "Accessibility"],
    "sameAs": [
      "https://github.com/Minimalistic",
      "https://www.linkedin.com/in/jason-marsh"
    ]
  })} />
  <div class="hero">
    <h1>Jason Marsh</h1>
    <p class="subtitle">
      Director of Technology at an assistive technology & older adult services nonprofit.
      <strong>13+ years in IT</strong> - infrastructure, assistive technology,
      and <strong>AI-integrated tools</strong> I design and build end to end.
    </p>
  </div>

  <div class="section-header">
    <h2>Selected Works</h2>
  </div>
  <p class="showcase-intro">A handful of my favorites.</p>
  <div class="showcase">
    {showcase.map((it) => (
      <a class="showcase-card" href={it.url}>
        <div class="showcase-cover">
          <img srcset={it.srcset} sizes={it.sizes} alt="" loading="lazy" decoding="async" style={`object-position: ${it.focus}`} />
        </div>
        <span class="showcase-label">
          <span class="showcase-title">{it.title}</span>
          <span class="showcase-kind">{it.kind}</span>
        </span>
      </a>
    ))}
  </div>

  <div class="section-header">
    <h2>Projects</h2>
    <a href="/projects/">View all</a>
  </div>
  {projects.map((p) => {
    const ago = p.data.updated ? (() => {
      const days = Math.floor((Date.now() - p.data.updated.valueOf()) / 86400000);
      if (days === 0) return 'today';
      if (days === 1) return 'yesterday';
      if (days < 30) return `${days}d ago`;
      if (days < 365) return `${Math.floor(days / 30)}mo ago`;
      return `${Math.floor(days / 365)}y ago`;
    })() : null;
    return (
      <a class="card" href={`/projects/${p.id}/`}>
        <h3>{p.data.title}<span class={`status status-${p.data.status}`} aria-label={({ idea: 'Idea', wip: 'Work in progress', shipped: 'Shipped', archived: 'Archived' })[p.data.status]}>{p.data.status}</span>{p.data.url && <span class="demo-badge">live demo</span>}</h3>
        <p class="meta">{p.data.description}</p>
        {ago && <p class="meta" style="margin-top:0.25rem;font-size:0.78rem;color:var(--fg-muted)">updated {ago}</p>}
        {p.data.tags && p.data.tags.length > 0 && (
          <div class="tags">
            {p.data.tags.map((t: string) => <span class="tag">{t}</span>)}
          </div>
        )}
      </a>
    );
  })}

  {posts.length > 0 && (
    <>
      <div class="section-header">
        <h2>Writing</h2>
        <a href="/posts/">View all</a>
      </div>
      {posts.map((p) => (
        <a class="card" href={`/posts/${p.id}/`}>
          <h3>{p.data.title}</h3>
          <p class="meta">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
        </a>
      ))}
    </>
  )}

  <style>
    /* 4 columns: the first (featured) tile spans a 2x2 block, the other
       four fill the 2x2 block beside it. Phones: featured full width on top,
       the rest in a 2x2 grid below. */
    .showcase {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1rem;
      margin: 0 0 0.5rem;
    }
    .showcase-card { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; text-decoration: none; }
    .showcase-card:first-child { grid-column: span 2; grid-row: span 2; }
    .showcase-cover {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 2;
      border-radius: 6px;
      overflow: hidden;
      background: var(--bg-soft, rgba(0, 0, 0, 0.04));
    }
    /* featured cover stretches to fill its two rows; the image is absolutely
       positioned so its intrinsic size can't inflate the row heights */
    .showcase-card:first-child .showcase-cover { aspect-ratio: auto; flex: 1; }
    .showcase-cover img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    @media (max-width: 600px) {
      .showcase { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .showcase-card:first-child { grid-row: auto; }
      .showcase-card:first-child .showcase-cover { aspect-ratio: 3 / 2; flex: none; }
    }
    @media (prefers-reduced-motion: no-preference) {
      .showcase-cover img { transition: transform 0.4s ease; }
      .showcase-card:hover .showcase-cover img { transform: scale(1.03); }
    }
    /* frosted plaque: the intro and labels sit straight over the foliage */
    .showcase-intro {
      display: inline-block;
      margin: 0 0 0.9rem;
      padding: 0.25em 0.7em;
      font-size: 0.9rem;
      color: var(--fg-soft);
      border: 1px solid var(--border);
      border-radius: 10px;
      background: color-mix(in srgb, var(--bg-elev) var(--glass-wash), transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(130%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(130%);
    }
    .showcase-label {
      display: inline-flex;
      flex-direction: column;
      max-width: 100%;
      margin-top: 0.45rem;
      padding: 0.25em 0.6em;
      line-height: 1.3;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: color-mix(in srgb, var(--bg-elev) var(--glass-wash), transparent);
      backdrop-filter: blur(var(--glass-blur)) saturate(130%);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(130%);
    }
    .showcase-card:first-child .showcase-title { font-size: 1rem; }
    .showcase-title {
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--fg);
    }
    .showcase-kind {
      font-size: 0.72rem;
      color: var(--fg-muted);
    }
  </style>
</Base>
