---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

// prose lives in src/content/pages/now.md so the llms.txt endpoints share the same source
const entry = await getEntry('pages', 'now');
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <h1>Now</h1>
  <p class="tagline">What I'm focused on right now. Inspired by <a href="https://nownownow.com/about">nownownow.com</a>.</p>

  <div class="prose">
    <Content />
  </div>

  <p style="color: var(--fg-soft); font-size: 0.85rem; font-family: var(--font-mono); margin-top: 3rem;">
    Updated {entry.data.updated}
  </p>
</Base>
