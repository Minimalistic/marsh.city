---
import Base from '../layouts/Base.astro';
---
<Base title="Resume" description="Jason Marsh - Director of Technology, 13+ years in IT, assistive technology, infrastructure, and AI engineering.">
  <div class="resume-print-header" aria-hidden="true">
    <div class="resume-print-id">
      <div class="resume-print-name">Jason Marsh</div>
      <p class="resume-print-contact">
        Duluth,&nbsp;MN
        <span class="sep">•</span>
        <a href="mailto:jason@marsh.city">jason@marsh.city</a>
        <span class="sep">•</span>
        <a href="https://marsh.city/">marsh.city</a>
        <span class="sep">•</span>
        <a href="https://www.linkedin.com/in/jason-marsh">linkedin.com/in/jason-marsh</a>
        <span class="sep">•</span>
        <a href="https://github.com/Minimalistic">github.com/Minimalistic</a>
      </p>
    </div>
    <img class="resume-print-qr" src="/qr.svg" alt="" width="56" height="56" />
  </div>

  <div class="prose">
    <div class="resume-top">
      <div class="resume-title">
        <span class="resume-kicker">Resume</span>
        <h1>Jason Marsh</h1>
      </div>
      <button class="resume-download" onclick="window.print()" aria-label="Print resume or save as PDF">Save as PDF</button>
    </div>

    <p class="resume-intro" data-summary="default">
      Director of Technology who ships production AI systems (Anthropic API:
      agentic tool-calling, retrieval, batch classification across 7,500+
      products) and turns operational messes into revenue: rebuilt AT billing
      and grew service revenue from $17K to $200K+ in one year. 13+ years
      across IT, assistive technology, and team leadership; ATACP-certified.
    </p>
    <p class="resume-intro" data-summary="eng" hidden>
      Director of Technology with 13+ years across IT, assistive technology
      services, and team leadership. Builds production AI systems on the
      Anthropic API - conversational intake, agentic tool-calling, retrieval,
      and batch classification across a 7,500-product catalog - with a focus
      on accessibility for people with disabilities and older adults.
      ATACP-certified in assistive technology assessment.
    </p>
    <script is:inline>
      // ?variant=eng swaps in the engineering-focused summary
      // (works in print/PDF too - render script passes the query through)
      if (new URLSearchParams(location.search).get('variant') === 'eng') {
        document.querySelector('[data-summary="default"]').hidden = true;
        document.querySelector('[data-summary="eng"]').hidden = false;
      }
    </script>

    <div class="resume-projects">
    <h2>Independent Projects</h2>
    <ul class="projects-compact">
      <li class="featured"><a class="project-name" href="https://whatcanhelp.com">WhatCanHelp<span class="open-icon" aria-hidden="true">↗</span></a><span class="project-desc"> (whatcanhelp.com) - assistive-technology product discovery platform, designed and built end-to-end: 7,500+ AI-classified products with conversational intake, shortlist/compare tools, and auto-generated funding-justification PDFs. Node/Express + SQLite (better-sqlite3), self-hosted behind Caddy/PM2; batch classification pipeline using prompt caching and the Batch API for cost efficiency, with schema-level guardrails against hallucinated product data.</span></li>
      <li><a class="project-name" href="https://mealdeck.net">MealDeck<span class="open-icon" aria-hidden="true">↗</span></a><span class="project-desc"> - built and launched a meal-planning app with Stripe billing, AI recipe adaptation, voice-controlled cook mode</span></li>
      <li><a class="project-name" href="/projects/radiogridxl/">RadioGridXL<span class="open-icon" aria-hidden="true">↗</span></a><span class="project-desc"> - zero-dependency accessible radio streaming app, WCAG AA, piloted with older adults at my organization</span></li>
      <li><a class="project-name" href="/projects/petfeedr/">PetFeedr<span class="open-icon" aria-hidden="true">↗</span></a><span class="project-desc"> - Raspberry Pi automated pet feeder with web interface, scheduling, and feed-time randomization</span></li>
      <li><a class="project-name" href="/projects/echoetcher/">EchoEtcher<span class="open-icon" aria-hidden="true">↗</span></a><span class="project-desc"> - voice-to-structured-notes pipeline using local Whisper and LLM processing</span></li>
      <li><span class="project-name">InfoVault (in development)</span><span class="project-desc"> - handheld device using camera-based LLM identification to read text aloud and describe objects for users with vision loss</span></li>
    </ul>
    </div>

    <h2>Experience</h2>

    <div class="resume-entry">
      <div class="resume-header">
        <strong>Director of Technology</strong>
        <span class="meta">May 2025 – Present</span>
      </div>
      <div class="resume-org">Lighthouse Center for Vital Living - Duluth, MN</div>
      <ul>
        <li>Lead IT and Assistive Technology divisions for a nonprofit serving people with disabilities and aging populations, overseeing infrastructure, AT services, and an AT lending library partnered with the Minnesota STAR Program</li>
        <li>Restructured AT billing operations and coached staff on proposals and invoicing, growing annual AT service revenue from $17K to over $200K within a year</li>
        <li>One of three organizational leaders reporting to the Executive Director; contribute to strategic planning, budgeting, and cross-department decision-making</li>
        <li>Manage a team of four including an IT support specialist, an ATP, and two AT specialists</li>
        <li>Embed with clients to assess needs and recommend assistive-technology solutions, and act as the in-house tech resource for colleagues - setting up technology on-site and training staff on the tools they use</li>
      </ul>
    </div>

    <div class="resume-entry">
      <div class="resume-header">
        <strong>IT Manager & Accessibility Specialist</strong>
        <span class="meta">Mar 2021 – May 2025</span>
      </div>
      <div class="resume-org">Lighthouse Center for Vital Living - Duluth, MN</div>
      <ul>
        <li>Conducted full systems audit; established documentation and standardized processes across the ~20-staff organization</li>
        <li>Led cloud migration to Microsoft 365 and Azure AD during a building relocation, reducing annual IT costs by $15,000+</li>
        <li>Established disaster recovery procedures, security protocols, and a technology replacement plan</li>
        <li>Managed endpoints via Microsoft Intune (Windows) and IBM MaaS360 (iOS/Android) for MDM, app deployment, and compliance</li>
        <li>Built centralized request tracking system to streamline IT and AT workflows</li>
      </ul>
    </div>

    <div class="resume-entry">
      <div class="resume-header">
        <strong>Accessible Technology Specialist</strong>
        <span class="meta">Oct 2020 – Mar 2021</span>
      </div>
      <div class="resume-org">Lighthouse Center for Vital Living - Duluth, MN</div>
      <ul>
        <li>Evaluated and configured assistive technology - screen readers, magnification tools, wearable devices - for clients with disabilities and aging-related needs</li>
        <li>Trained staff and clients on AT usage; attended ATIA and Closing The Gap conferences</li>
      </ul>
    </div>

    <div class="resume-entry">
      <div class="resume-header">
        <strong>Technical Administrator</strong>
        <span class="meta">Nov 2012 – Nov 2020</span>
      </div>
      <div class="resume-org">Westside Pet Clinic - Duluth, MN</div>
      <ul>
        <li>Sole IT administrator for a small family-owned veterinary practice - eight years covering all hardware, networking, and software</li>
        <li>Led the clinic's transition from paper records to an electronic medical records system</li>
      </ul>
    </div>

    <h2>Technical Skills</h2>
    <dl class="resume-skills-compact">
      <div><dt>AI & ML</dt><dd>Claude API (Anthropic SDK - tool use, Batch API, prompt caching, structured outputs), Claude Code, OpenAI Whisper, Ollama, Hermes, RAG & Embeddings</dd></div>
      <div><dt>Development</dt><dd>Python, JavaScript, Node.js, Express, SQLite, PowerShell, HTML/CSS, Git, Docker, GitHub Actions, Arduino/ESP-8266</dd></div>
      <div><dt>Infrastructure</dt><dd>Microsoft 365, Azure AD, Active Directory, Windows Server, Hyper-V, VMware/ESXi, Proxmox VE, DNS/DHCP, VPN, Firewall Management</dd></div>
      <div><dt>Endpoint & Security</dt><dd>Microsoft Intune, IBM MaaS360, Linux Administration, Disaster Recovery, Incident Response, Cloud Security</dd></div>
      <div><dt>Platforms</dt><dd>SharePoint, Microsoft Teams, ServiceNow, FreshDesk, Tailscale</dd></div>
    </dl>

    <h2>Education & Certifications</h2>
    <table class="resume-edu">
      <tr><td><strong>Assistive Technology Applications Certificate (ATACP)</strong></td><td>CSUN</td><td class="meta">2025</td></tr>
      <tr><td><strong>Network Admin & Cybersecurity</strong> (coursework)</td><td>Lake Superior College</td><td class="meta">2022</td></tr>
      <tr><td><strong>Full Stack Web Developer Nanodegree</strong></td><td>Udacity</td><td class="meta">2018</td></tr>
      <tr><td><strong>B.S. Video Game Art & Design</strong></td><td>Art Institute of Pittsburgh</td><td class="meta">2010</td></tr>
    </table>

    <h2 class="resume-contact-h">Get in touch</h2>
    <div class="resume-contact">
      <ul>
        <li>Email: <a href="mailto:jason@marsh.city">jason@marsh.city</a></li>
        <li>LinkedIn: <a href="https://www.linkedin.com/in/jason-marsh">jason-marsh</a></li>
        <li>GitHub: <a href="https://github.com/Minimalistic">Minimalistic</a></li>
      </ul>
      <a href="/" class="resume-qr" aria-label="Link to marsh.city">
        <img src="/qr.svg" alt="QR code linking to marsh.city" width="72" height="72" />
        <span>marsh.city</span>
      </a>
    </div>
  </div>
</Base>

<style>
  .resume-intro {
    font-size: 1.05rem;
    color: var(--fg-soft);
    margin-bottom: 1.5rem;
    line-height: 1.7;
  }
  .resume-entry {
    margin-bottom: 1rem;
  }
  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .resume-org {
    color: var(--fg-soft);
    font-size: 0.9rem;
    margin-bottom: 0.25rem;
  }
  .resume-entry ul {
    margin-top: 0.25rem;
    margin-bottom: 0;
  }
  .resume-entry li {
    margin-bottom: 0.15rem;
  }
  .projects-compact {
    margin-top: 0.25rem;
  }
  .projects-compact li {
    margin-bottom: 0.25rem;
  }
  /* featured project: leaf accent bar so the flagship leads the list.
     margin-left cancels the ul's 1.25rem padding so the bar sits at the
     list edge, padding-left restores the text indent. */
  .projects-compact li.featured {
    list-style: none;
    margin-left: -1.25rem;
    padding-left: 1.1rem;
    border-left: 2px solid var(--leaf);
  }

  /* skills as inline definition list */
  .resume-skills-compact {
    margin: 0.5rem 0 1rem;
  }
  .resume-skills-compact div {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    line-height: 1.5;
  }
  .resume-skills-compact dt {
    font-weight: 600;
    font-size: 0.85rem;
    min-width: 130px;
    flex-shrink: 0;
    color: var(--fg);
  }
  .resume-skills-compact dd {
    margin: 0;
    font-size: 0.88rem;
    color: var(--fg-soft);
  }

  /* education as compact table */
  .resume-edu {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 0.5rem 0 1rem;
  }
  .resume-edu td {
    padding: 0.3rem 0.5rem 0.3rem 0;
    vertical-align: baseline;
    border: none;
  }
  .resume-edu td:last-child {
    text-align: right;
    white-space: nowrap;
  }

  .resume-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .resume-title {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .resume-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--leaf);
  }
  .resume-top h1 {
    margin: 0;
    line-height: 1.1;
  }
  .resume-download {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    padding: 0.45em 1.1em;
    border-radius: var(--radius-sm);
    background: var(--bg-elev2);
    color: var(--fg-soft);
    border: 1px solid var(--border);
    cursor: pointer;
    position: relative;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease,
      transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
  }
  /* invisible hit-area extension so the button doesn't flee a pointer
     hovering on its bottom edge while lifting */
  .resume-download::before {
    content: '';
    position: absolute;
    inset: -4px;
    z-index: -1;
  }
  .resume-download:hover {
    color: var(--leaf);
    border-color: var(--leaf);
    background: color-mix(in srgb, var(--leaf) 8%, var(--bg-elev2));
    transform: translateY(-2px);
    box-shadow: 0 4px 12px -2px color-mix(in srgb, var(--leaf) 25%, transparent);
  }
  .resume-download:active {
    transform: translateY(0);
    box-shadow: 0 1px 3px -1px color-mix(in srgb, var(--leaf) 20%, transparent);
    transition: transform 0.08s ease, box-shadow 0.08s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .resume-download,
    .resume-download:hover,
    .resume-download:active {
      transform: none;
      transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
  }

  .resume-contact {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-top: 1rem;
  }
  .resume-contact ul {
    margin: 0;
  }
  .resume-print-header { display: none; }

  .projects-compact a .open-icon {
    display: inline-block;
    font-size: 0.8em;
    margin-left: 0.15em;
    color: var(--leaf);
    opacity: 0.75;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .projects-compact a:hover .open-icon {
    transform: translate(1px, -1px);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .projects-compact a:hover .open-icon { transform: none; }
  }
  .resume-qr {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    flex-shrink: 0;
    color: inherit;
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .resume-qr::after { display: none; }
  .resume-qr:hover {
    transform: translateY(-1px);
  }
  .resume-qr:hover span {
    color: var(--leaf);
  }
  .resume-qr img {
    border-radius: var(--radius-sm);
  }
  .resume-qr span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }
  :root[data-theme="dark"] .resume-qr img {
    filter: invert(1);
  }

  @media (max-width: 600px) {
    .resume-skills-compact div {
      flex-direction: column;
      gap: 0;
    }
    .resume-skills-compact dt {
      min-width: auto;
    }
    .resume-edu td:nth-child(2) {
      display: none;
    }
  }
</style>

<style is:global>
  @page {
    size: letter;
    margin: 0.6in;
  }

  @media print {
    nav.site-nav,
    footer.site-foot,
    .skip-link,
    .layout::before,
    body::after { display: none !important; }

    *, *::before, *::after {
      background: white !important;
      box-shadow: none !important;
    }
    body, .layout {
      color: #1a1a1a !important;
      padding: 0 !important;
      margin: 0 !important;
      max-width: none !important;
      font-size: 10.5pt !important;
      line-height: 1.45 !important;
    }
    /* the screen frost caps prose at 65ch for readability; on paper that
       strands a dead column down the right side — let it fill the page */
    .prose {
      max-width: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    /* Headings, labels, and meta set their own color via var(--fg*).
       In dark mode that resolves to cream, which prints as off-white on
       the forced-white page (body's color reset doesn't reach elements
       with an explicit color of their own). Pin them to ink/grey so
       contrast holds no matter which theme the PDF is generated from. */
    h2,
    .resume-print-name,
    .resume-skills-compact dt {
      color: #1a1a1a !important;
    }
    .resume-org,
    .resume-skills-compact dd,
    .meta {
      color: #555 !important;
    }

    .resume-top { display: none !important; }

    .resume-print-header {
      display: flex !important;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      border-bottom: 1px solid #ccc;
      padding-bottom: 0.4rem;
      margin-bottom: 0.5rem;
    }
    /* pin the header QR to plain black-on-white regardless of the screen
       theme it was printed from (dark mode inverts the on-screen QR) */
    .resume-print-qr {
      flex-shrink: 0;
      filter: none !important;
    }
    .resume-print-name {
      font-family: var(--font-serif);
      font-size: 22pt;
      font-weight: 600;
      line-height: 1;
      margin-bottom: 0.3em;
    }
    .resume-print-contact {
      font-size: 8.5pt;
      line-height: 1.6;
      color: #555 !important;
      margin: 0 !important;
    }
    .resume-print-contact .sep {
      margin: 0 0.35em;
      color: #888;
    }
    h1 { display: none; }

    /* never leave a section header orphaned at the bottom of a page */
    h2 {
      font-size: 11pt !important;
      margin-top: 0.9rem !important;
      margin-bottom: 0.4rem !important;
      border-color: #ccc !important;
      padding-bottom: 0.2rem !important;
      break-after: avoid;
    }
    .resume-intro {
      font-size: 9.5pt !important;
      color: #333 !important;
      margin-bottom: 0.5rem !important;
      line-height: 1.5 !important;
    }
    /* keep an entry's heading with its bullets across a page break */
    .resume-entry { margin-bottom: 0.5rem !important; break-inside: avoid; }
    .resume-entry li { margin-bottom: 0 !important; font-size: 9.5pt; }
    .resume-org { font-size: 8.5pt !important; }
    .resume-skills-compact dt { font-size: 9pt !important; }
    .resume-skills-compact dd { font-size: 9pt !important; }
    .resume-skills-compact div { margin-bottom: 0.15rem !important; }
    .resume-edu { font-size: 9pt !important; }
    .resume-edu td { padding: 0.15rem 0.5rem 0.15rem 0 !important; }
    /* keep a single project (title + its description) from splitting across a
       page break; the title-detachment bug itself is fixed by the position:static
       rule above, not by this */
    .projects-compact li { font-size: 9.5pt; margin-bottom: 0.1rem !important; break-inside: avoid; }
    /* match the featured accent bar to print's narrower 1rem list padding */
    .projects-compact li.featured { margin-left: -1rem !important; padding-left: 0.9rem !important; }

    /* contact info already lives in the print header (with the QR) —
       printing the Get in touch section would duplicate it on a one-pager */
    .resume-contact-h,
    .resume-contact { display: none !important; }

    a { color: #1a1a1a !important; text-decoration: none !important; }
    a::after { display: none !important; }
    /* ROOT CAUSE FIX: the global `a { position: relative }` (for the animated
       hover underline) leaks into print. WebKit's paged-layout engine mispaints
       relatively-positioned inline-blocks, collecting the project title links at
       the bottom of the section instead of beside their descriptions. Force
       static positioning so every anchor paints in normal flow -- but exclude
       .skip-link, which relies on position:absolute (top:-100%) to stay
       off-screen; the line above also display:none's it in print. */
    a:not(.skip-link) { position: static !important; }

    /* real anchors in the print header stay inline, no pill styling */
    .resume-print-contact a {
      color: #555 !important;
      border: none !important;
      padding: 0 !important;
      display: inline !important;
    }

    /* give project titles a pill affordance with an ↗ open indicator.
       display:inline (not inline-block) keeps the pill in normal inline flow,
       which paged engines lay out reliably; single-token titles never wrap, so
       the border still reads as a pill. */
    .projects-compact a.project-name {
      display: inline;
      border: 0.5pt solid #888 !important;
      border-radius: 3pt;
      padding: 0 0.4em;
      font-weight: 500;
    }
    .projects-compact .project-name .open-icon {
      color: #555 !important;
      font-size: 0.85em;
      margin-left: 0.15em;
      opacity: 1 !important;
    }

    .prose ul, .prose ol { padding-left: 1rem !important; }
  }
</style>
