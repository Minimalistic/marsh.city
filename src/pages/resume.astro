---
import Base from '../layouts/Base.astro';
import resume from '../data/resume.json';
import { renderResume } from '../lib/resume-html.mjs';
// Canonical data + shared renderer: the same pair drives the per-job PDF
// variants (scripts/resume-pdf.mjs), so the public page and every generated
// PDF stay in lockstep. Styles moved to resume.css for the same reason.
import '../styles/resume.css';
---
<Base title="Resume" description="Jason Marsh - Director of Technology, 13+ years in IT, assistive technology, infrastructure, and AI engineering.">
  <Fragment set:html={renderResume(resume)} />
</Base>
