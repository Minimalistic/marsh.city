---
import Base from '../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

// prose lives in src/content/pages/about.md so the llms.txt endpoints share the same source
const entry = await getEntry('pages', 'about');
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="prose about-prose">
    <h1>About</h1>
    <img src="/jason.jpg" alt="Jason Marsh, headshot portrait" class="about-photo" width="240" height="240" />
    <Content />
  </div>
</Base>

<!-- is:global because <Content /> output doesn't carry Astro's scoped-style attribute;
     every selector stays prefixed with .about-prose, which only this page uses -->
<style is:global>
  /* magazine-style wrap: text flows to the right of the photo and continues
     below it with the same visual gap on all sides */
  .about-prose .about-photo {
    float: left;
    width: 240px;
    height: 240px;
    margin: 0.35rem 1.75rem 1rem 0;
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: var(--shadow);
    shape-outside: inset(0 round var(--radius-lg));
  }
  .about-prose p {
    text-wrap: pretty;
  }
  /* clear the float before the h2 so "Get in touch" never sits beside the photo */
  .about-prose h2 {
    clear: left;
  }
  @media (max-width: 600px) {
    .about-prose .about-photo {
      float: none;
      display: block;
      width: 160px;
      height: 160px;
      margin: 0 auto 1.25rem;
    }
  }
</style>
