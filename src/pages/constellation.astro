---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
const projectData = projects.map(p => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  status: p.data.status,
  tags: p.data.tags,
  url: `/projects/${p.id}/`,
  started: p.data.started?.toISOString().slice(0, 10) ?? null,
}));
---
<Base title="Constellation" description="An interactive map of Jason Marsh's projects and the threads that connect them.">
  <div class="constellation-wrap">
    <canvas id="constellation" aria-label="Interactive project constellation — click a node to visit the project"></canvas>
    <div class="constellation-tooltip" id="tooltip" role="tooltip" aria-hidden="true">
      <div class="tooltip-title"></div>
      <div class="tooltip-desc"></div>
      <div class="tooltip-tags"></div>
      <div class="tooltip-hint">click to visit</div>
    </div>
    <div class="constellation-title" id="page-title">
      <h1>Constellation</h1>
      <p>The threads between projects</p>
    </div>
    <div class="constellation-legend">
      <span class="legend-item"><span class="legend-dot shipped"></span>shipped</span>
      <span class="legend-item"><span class="legend-dot wip"></span>wip</span>
      <span class="legend-item"><span class="legend-dot idea"></span>idea</span>
      <span class="legend-hint">hover to explore — click to visit — drag to move</span>
    </div>
  </div>
</Base>

<style>
  .constellation-wrap {
    position: fixed;
    inset: 0;
    z-index: 2;
    overflow: hidden;
  }
  #constellation {
    width: 100%;
    height: 100%;
    display: block;
    cursor: grab;
  }
  #constellation:active { cursor: grabbing; }

  .constellation-tooltip {
    position: fixed;
    pointer-events: none;
    background: var(--bg-elev);
    border: 1px solid var(--border-leaf);
    border-radius: var(--radius);
    padding: 14px 18px;
    max-width: 280px;
    box-shadow: var(--shadow-lg), var(--shadow-glow);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s, transform 0.2s;
    z-index: 10;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .constellation-tooltip.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .tooltip-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--fg);
    margin-bottom: 4px;
  }
  .tooltip-desc {
    font-size: 0.82rem;
    color: var(--fg-soft);
    line-height: 1.45;
    margin-bottom: 8px;
  }
  .tooltip-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 6px;
  }
  .tooltip-tags span {
    font-size: 0.7rem;
    padding: 2px 7px;
    border-radius: 99px;
    background: var(--accent-glow);
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .tooltip-hint {
    font-size: 0.68rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .constellation-legend {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 0.78rem;
    color: var(--fg-muted);
    z-index: 10;
    flex-wrap: wrap;
    justify-content: center;
  }
  .legend-item {
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }
  .legend-dot.shipped { background: #8db860; box-shadow: 0 0 6px rgba(141,184,96,0.5); }
  .legend-dot.wip { background: #6d9a48; box-shadow: 0 0 6px rgba(109,154,72,0.4); }
  .legend-dot.idea { background: #7a6550; box-shadow: 0 0 6px rgba(122,101,80,0.4); }
  .legend-hint {
    font-size: 0.7rem;
    opacity: 0.6;
  }

  .constellation-title {
    position: fixed;
    top: 80px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    z-index: 10;
    pointer-events: none;
    transition: opacity 0.6s;
  }
  .constellation-title.faded { opacity: 0.15; }
  .constellation-title h1 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--fg);
    margin: 0 0 4px;
    letter-spacing: 0.04em;
  }
  .constellation-title p {
    font-size: 0.82rem;
    color: var(--fg-muted);
    margin: 0;
  }

  /* full-bleed: hide footer, foliage, remove layout constraints */
  :global(.site-foot) { display: none !important; }
  :global(.site-foot-foliage) { display: none !important; }
  :global(main#main) { padding: 0 !important; margin: 0 !important; max-width: none !important; }
  :global(.layout) { max-width: none !important; padding: 0 !important; }
</style>

<script is:inline define:vars={{ projectData }}>
(function() {
  'use strict';
  const canvas = document.getElementById('constellation');
  const tooltip = document.getElementById('tooltip');
  const ctx = canvas.getContext('2d');
  let W, H, dpr;
  let nodes = [];
  let edges = [];
  let particles = [];
  let hoveredNode = null;
  let dragNode = null;
  let mouseX = -9999, mouseY = -9999;
  let animId;
  let introProgress = 0; // 0 to 1 over ~1.2s

  // -- color helpers --
  const style = getComputedStyle(document.documentElement);
  function cssVar(name) { return style.getPropertyValue(name).trim(); }

  function getColors() {
    const s = getComputedStyle(document.documentElement);
    return {
      bg: s.getPropertyValue('--bg').trim(),
      fg: s.getPropertyValue('--fg').trim(),
      fgSoft: s.getPropertyValue('--fg-soft').trim(),
      fgMuted: s.getPropertyValue('--fg-muted').trim(),
      accent: s.getPropertyValue('--accent').trim(),
      accentBright: s.getPropertyValue('--accent-bright').trim(),
      leaf: '#6d9a48',
      leafBright: '#8db860',
      leafPale: '#a8cc85',
      bark: '#7a6550',
      moss: '#2d5016',
      cream: '#e8e6d2',
    };
  }
  let C = getColors();

  const statusColor = {
    shipped: () => C.leafBright,
    wip: () => C.leaf,
    idea: () => C.bark,
    archived: () => C.fgMuted,
  };

  // -- resize --
  function resize() {
    dpr = window.devicePixelRatio || 1;
    W = window.innerWidth;
    H = window.innerHeight;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  // -- init nodes --
  function init() {
    resize();
    C = getColors();
    const cx = W / 2;
    const cy = H / 2;
    const spread = Math.min(W, H) * 0.3;

    introProgress = 0;
    nodes = projectData.map((p, i) => {
      const angle = (i / projectData.length) * Math.PI * 2 - Math.PI / 2;
      const r = spread * (0.6 + Math.random() * 0.4);
      return {
        ...p,
        // target position — nodes start at center and animate out
        tx: cx + Math.cos(angle) * r,
        ty: cy + Math.sin(angle) * r,
        x: cx,
        y: cy,
        vx: 0,
        vy: 0,
        radius: 18 + p.tags.length * 5,
        baseRadius: 18 + p.tags.length * 5,
        pulsePhase: Math.random() * Math.PI * 2,
        pinned: false,
        introDelay: i * 0.08, // stagger per node
      };
    });

    // build edges from shared tags
    edges = [];
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const shared = nodes[i].tags.filter(t => nodes[j].tags.includes(t));
        if (shared.length > 0) {
          edges.push({ a: i, b: j, shared, strength: shared.length });
        }
      }
    }

    // ambient particles
    particles = [];
    const particleCount = Math.min(80, Math.floor(W * H / 12000));
    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.3,
        vy: (Math.random() - 0.5) * 0.3,
        size: Math.random() * 1.8 + 0.5,
        alpha: Math.random() * 0.3 + 0.05,
      });
    }
  }

  // -- physics --
  function physics() {
    const cx = W / 2;
    const cy = H / 2;
    const damping = 0.92;
    const centerPull = 0.0003;
    const repulsion = 6000;
    const springK = 0.003;
    const springRest = Math.min(W, H) * 0.22;

    for (let i = 0; i < nodes.length; i++) {
      const n = nodes[i];
      if (n.pinned) continue;

      // center gravity
      n.vx += (cx - n.x) * centerPull;
      n.vy += (cy - n.y) * centerPull;

      // repulsion from other nodes
      for (let j = 0; j < nodes.length; j++) {
        if (i === j) continue;
        const m = nodes[j];
        let dx = n.x - m.x;
        let dy = n.y - m.y;
        let dist = Math.sqrt(dx * dx + dy * dy) || 1;
        let force = repulsion / (dist * dist);
        n.vx += (dx / dist) * force;
        n.vy += (dy / dist) * force;
      }
    }

    // spring forces along edges
    for (const e of edges) {
      const a = nodes[e.a];
      const b = nodes[e.b];
      let dx = b.x - a.x;
      let dy = b.y - a.y;
      let dist = Math.sqrt(dx * dx + dy * dy) || 1;
      let force = (dist - springRest) * springK * e.strength;
      let fx = (dx / dist) * force;
      let fy = (dy / dist) * force;
      if (!a.pinned) { a.vx += fx; a.vy += fy; }
      if (!b.pinned) { b.vx -= fx; b.vy -= fy; }
    }

    // integrate
    for (const n of nodes) {
      if (n.pinned) continue;
      n.vx *= damping;
      n.vy *= damping;
      n.x += n.vx;
      n.y += n.vy;
      // keep on screen
      const pad = n.radius + 20;
      n.x = Math.max(pad, Math.min(W - pad, n.x));
      n.y = Math.max(pad + 60, Math.min(H - pad - 60, n.y));
    }
  }

  // -- particles --
  function updateParticles() {
    for (const p of particles) {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) p.x = W;
      if (p.x > W) p.x = 0;
      if (p.y < 0) p.y = H;
      if (p.y > H) p.y = 0;
    }
  }

  // -- drawing --
  function draw(t) {
    ctx.clearRect(0, 0, W, H);

    // subtle radial gradient background for depth
    const bgGrad = ctx.createRadialGradient(W/2, H/2, 0, W/2, H/2, Math.max(W, H) * 0.7);
    bgGrad.addColorStop(0, 'rgba(109, 154, 72, 0.04)');
    bgGrad.addColorStop(1, 'transparent');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, W, H);

    // ambient particles
    for (const p of particles) {
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = C.leaf;
      ctx.globalAlpha = p.alpha;
      ctx.fill();
    }
    ctx.globalAlpha = 1;

    // edges — curved with tag labels on hover
    for (const e of edges) {
      const a = nodes[e.a];
      const b = nodes[e.b];
      const isHovered = hoveredNode && (hoveredNode === a || hoveredNode === b);
      const alpha = isHovered ? 0.4 + e.strength * 0.1 : 0.1 + e.strength * 0.06;
      const width = isHovered ? 1.5 + e.strength * 0.5 : 0.5 + e.strength * 0.3;

      // curve control point — offset perpendicular to the line
      const mx = (a.x + b.x) / 2;
      const my = (a.y + b.y) / 2;
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const dist = Math.sqrt(dx * dx + dy * dy) || 1;
      const bulge = dist * 0.12;
      const cpx = mx + (-dy / dist) * bulge;
      const cpy = my + (dx / dist) * bulge;

      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.quadraticCurveTo(cpx, cpy, b.x, b.y);
      ctx.strokeStyle = C.leaf;
      ctx.globalAlpha = alpha;
      ctx.lineWidth = width;
      ctx.stroke();

      if (isHovered) {
        // animated pulse along curve
        const progress = (t % 2500) / 2500;
        const tp = progress;
        const px = (1-tp)*(1-tp)*a.x + 2*(1-tp)*tp*cpx + tp*tp*b.x;
        const py = (1-tp)*(1-tp)*a.y + 2*(1-tp)*tp*cpy + tp*tp*b.y;
        ctx.beginPath();
        ctx.arc(px, py, 3, 0, Math.PI * 2);
        ctx.fillStyle = C.leafBright;
        ctx.globalAlpha = 0.7;
        ctx.fill();

        // shared tag labels along the edge
        const tagFont = `500 9px ${cssVar('--font-mono') || 'monospace'}`;
        ctx.font = tagFont;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        for (let ti = 0; ti < e.shared.length; ti++) {
          const frac = (ti + 1) / (e.shared.length + 1);
          const lx = (1-frac)*(1-frac)*a.x + 2*(1-frac)*frac*cpx + frac*frac*b.x;
          const ly = (1-frac)*(1-frac)*a.y + 2*(1-frac)*frac*cpy + frac*frac*b.y;
          // pill background
          const tag = e.shared[ti];
          const tw = ctx.measureText(tag).width + 10;
          ctx.globalAlpha = 0.85;
          ctx.fillStyle = C.bg || '#e8e6d2';
          ctx.beginPath();
          if (ctx.roundRect) { ctx.roundRect(lx - tw/2, ly - 8, tw, 16, 4); }
          else { ctx.rect(lx - tw/2, ly - 8, tw, 16); }
          ctx.fill();
          ctx.strokeStyle = C.leaf;
          ctx.globalAlpha = 0.4;
          ctx.lineWidth = 1;
          ctx.stroke();
          // text
          ctx.globalAlpha = 0.9;
          ctx.fillStyle = C.accent || C.leaf;
          ctx.fillText(tag, lx, ly);
        }
      }
    }
    ctx.globalAlpha = 1;

    // nodes
    for (const n of nodes) {
      const isHovered = n === hoveredNode;
      const pulse = Math.sin(t * 0.002 + n.pulsePhase) * 0.12 + 1;
      const r = n.baseRadius * pulse * (isHovered ? 1.2 : 1);
      const color = (statusColor[n.status] || statusColor.wip)();

      // outer glow
      const glowR = r * (isHovered ? 2.8 : 2);
      const grad = ctx.createRadialGradient(n.x, n.y, r * 0.3, n.x, n.y, glowR);
      grad.addColorStop(0, color);
      grad.addColorStop(1, 'transparent');
      ctx.beginPath();
      ctx.arc(n.x, n.y, glowR, 0, Math.PI * 2);
      ctx.fillStyle = grad;
      ctx.globalAlpha = isHovered ? 0.25 : 0.1;
      ctx.fill();
      ctx.globalAlpha = 1;

      // core circle
      ctx.beginPath();
      ctx.arc(n.x, n.y, r, 0, Math.PI * 2);
      const coreGrad = ctx.createRadialGradient(n.x - r * 0.3, n.y - r * 0.3, 0, n.x, n.y, r);
      coreGrad.addColorStop(0, C.leafBright);
      coreGrad.addColorStop(1, color);
      ctx.fillStyle = coreGrad;
      ctx.globalAlpha = isHovered ? 0.95 : 0.75;
      ctx.fill();
      ctx.globalAlpha = 1;

      // ring
      ctx.beginPath();
      ctx.arc(n.x, n.y, r + 1, 0, Math.PI * 2);
      ctx.strokeStyle = color;
      ctx.globalAlpha = isHovered ? 0.7 : 0.3;
      ctx.lineWidth = isHovered ? 2 : 1;
      ctx.stroke();
      ctx.globalAlpha = 1;

      // label
      ctx.font = `600 ${isHovered ? 13 : 11}px ${cssVar('--font-sans') || 'Inter, sans-serif'}`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillStyle = C.fg;
      ctx.globalAlpha = isHovered ? 1 : 0.7;
      ctx.fillText(n.title, n.x, n.y + r + 8);
      ctx.globalAlpha = 1;

      // tag count inside node
      ctx.font = `700 ${Math.round(r * 0.55)}px ${cssVar('--font-mono') || 'monospace'}`;
      ctx.textBaseline = 'middle';
      ctx.fillStyle = C.cream;
      ctx.globalAlpha = isHovered ? 0.9 : 0.5;
      ctx.fillText(n.tags.length, n.x, n.y);
      ctx.globalAlpha = 1;
    }
  }

  // -- tooltip --
  function updateTooltip() {
    if (!hoveredNode || dragNode) {
      tooltip.classList.remove('visible');
      tooltip.setAttribute('aria-hidden', 'true');
      return;
    }
    const n = hoveredNode;
    tooltip.querySelector('.tooltip-title').textContent = n.title;
    tooltip.querySelector('.tooltip-desc').textContent = n.description;
    tooltip.querySelector('.tooltip-tags').innerHTML = n.tags.map(t => `<span>${t}</span>`).join('');

    // position tooltip
    let tx = n.x + n.baseRadius + 20;
    let ty = n.y - 30;
    const rect = tooltip.getBoundingClientRect();
    if (tx + rect.width > W - 20) tx = n.x - rect.width - n.baseRadius - 20;
    if (ty + rect.height > H - 80) ty = H - rect.height - 80;
    if (ty < 80) ty = 80;

    tooltip.style.left = tx + 'px';
    tooltip.style.top = ty + 'px';
    tooltip.classList.add('visible');
    tooltip.setAttribute('aria-hidden', 'false');
  }

  // -- hit test --
  function nodeAt(x, y) {
    for (let i = nodes.length - 1; i >= 0; i--) {
      const n = nodes[i];
      const dx = x - n.x;
      const dy = y - n.y;
      if (dx * dx + dy * dy < (n.baseRadius + 10) * (n.baseRadius + 10)) return n;
    }
    return null;
  }

  // -- events --
  canvas.addEventListener('mousemove', e => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    if (dragNode) {
      dragNode.x = mouseX;
      dragNode.y = mouseY;
      dragNode.vx = 0;
      dragNode.vy = 0;
      return;
    }
    const hit = nodeAt(mouseX, mouseY);
    if (hit !== hoveredNode) {
      hoveredNode = hit;
      canvas.style.cursor = hit ? 'pointer' : 'grab';
      updateTooltip();
      document.getElementById('page-title').classList.toggle('faded', !!hit);
    }
  });

  canvas.addEventListener('mousedown', e => {
    const hit = nodeAt(e.clientX, e.clientY);
    if (hit) {
      dragNode = hit;
      hit.pinned = true;
      canvas.style.cursor = 'grabbing';
    }
  });

  window.addEventListener('mouseup', () => {
    if (dragNode) {
      dragNode.pinned = false;
      // if barely moved, treat as click
      dragNode = null;
      canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
    }
  });

  canvas.addEventListener('click', e => {
    const hit = nodeAt(e.clientX, e.clientY);
    if (hit) {
      window.location.href = hit.url;
    }
  });

  // touch support
  let touchStartNode = null;
  let touchStartPos = null;
  canvas.addEventListener('touchstart', e => {
    const touch = e.touches[0];
    const hit = nodeAt(touch.clientX, touch.clientY);
    if (hit) {
      touchStartNode = hit;
      touchStartPos = { x: touch.clientX, y: touch.clientY };
      hit.pinned = true;
      dragNode = hit;
      e.preventDefault();
    }
  }, { passive: false });

  canvas.addEventListener('touchmove', e => {
    if (dragNode) {
      const touch = e.touches[0];
      dragNode.x = touch.clientX;
      dragNode.y = touch.clientY;
      dragNode.vx = 0;
      dragNode.vy = 0;
      hoveredNode = dragNode;
      updateTooltip();
      e.preventDefault();
    }
  }, { passive: false });

  canvas.addEventListener('touchend', e => {
    if (dragNode) {
      dragNode.pinned = false;
      // detect tap vs drag
      if (touchStartPos && touchStartNode) {
        const touch = e.changedTouches[0];
        const dx = touch.clientX - touchStartPos.x;
        const dy = touch.clientY - touchStartPos.y;
        if (dx * dx + dy * dy < 100) {
          window.location.href = touchStartNode.url;
        }
      }
      dragNode = null;
      touchStartNode = null;
      touchStartPos = null;
      hoveredNode = null;
      updateTooltip();
    }
  });

  window.addEventListener('resize', () => {
    resize();
    // re-center if nodes drifted off screen
    for (const n of nodes) {
      n.x = Math.max(n.radius + 20, Math.min(W - n.radius - 20, n.x));
      n.y = Math.max(n.radius + 80, Math.min(H - n.radius - 80, n.y));
    }
  });

  // theme changes
  const observer = new MutationObserver(() => { C = getColors(); });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  // easeOutBack for satisfying overshoot
  function easeOutBack(x) {
    const c1 = 1.70158;
    const c3 = c1 + 1;
    return 1 + c3 * Math.pow(x - 1, 3) + c1 * Math.pow(x - 1, 2);
  }

  // -- loop --
  let startTime = 0;
  function loop(t) {
    if (!startTime) startTime = t;
    const elapsed = (t - startTime) / 1000; // seconds

    if (introProgress < 1) {
      // intro: ease nodes from center to target positions
      introProgress = Math.min(1, elapsed / 1.4);
      const cx = W / 2;
      const cy = H / 2;
      for (const n of nodes) {
        const nodeT = Math.max(0, Math.min(1, (introProgress - n.introDelay) / 0.7));
        const ease = easeOutBack(nodeT);
        n.x = cx + (n.tx - cx) * ease;
        n.y = cy + (n.ty - cy) * ease;
      }
    } else {
      physics();
    }

    updateParticles();
    draw(t);
    updateTooltip();
    animId = requestAnimationFrame(loop);
  }

  init();
  animId = requestAnimationFrame(loop);
})();
</script>
